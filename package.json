{
	"name": "@zextras/carbonio-ui-emoji-picker",
	"version": "0.0.0-semantically-released",
	"description": "Shared emoji picker for Zextras Carbonio",
	"main": "./lib/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"exports": {
		"import": "./lib/index.js",
		"require": "./lib/index.js"
	},
	"files": [
		"lib",
		"COPYING",
		"THIRDPARTIES",
		"README.md"
	],
	"scripts": {
		"prebuild:lib": "rm -rf lib",
		"build:lib": "tsc -p tsconfig.lib.json",
		"build": "pnpm run build:lib",
		"prepare": "is-ci || husky",
		"prepack": "pnpm run build",
		"type-check": "tsc",
		"type-check:watch": "pnpm run type-check -- --watch",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"packTo": "pnpm pack --pack-destination $PKG_PATH && cd $PKG_PATH && pnpm add zextras-carbonio-ui-emoji-picker-$npm_package_version.tgz",
		"deploy": "pnpm pack && rm -rf $PKG_PATH/node_modules/@zextras/carbonio-ui-emoji-picker/* && tar -xf zextras-carbonio-ui-emoji-picker-$npm_package_version.tgz -C $PKG_PATH/node_modules/@zextras/carbonio-ui-emoji-picker/ --strip-components 1",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"postbuild": "is-ci || ./scripts/check-build.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zextras/carbonio-ui-emoji-picker.git"
	},
	"keywords": [],
	"author": "Zextras DEV Team <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "20.19.37",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@vitest/coverage-v8": "3.2.4",
		"@vitest/ui": "3.2.4",
		"@zextras/carbonio-ui-configs": "1.0.4",
		"conventional-changelog-conventionalcommits": "9.3.0",
		"eslint": "8.57.1",
		"eslint-plugin-notice": "1.0.0",
		"husky": "9.1.7",
		"is-ci": "4.1.0",
		"jsdom": "27.4.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"semantic-release": "24.2.9",
		"sonarqube-scanner": "4.3.5",
		"ts-node": "10.9.2",
		"typescript": "5.8.2",
		"vitest": "3.2.4",
		"vitest-fail-on-console": "0.10.1"
	},
	"dependencies": {
		"@emoji-mart/data": "1.2.1",
		"emoji-mart": "5.6.0"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"browserslist": [
		">1%",
		"last 1 version",
		"Firefox ESR",
		"not dead"
	],
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.32.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"unrs-resolver"
		]
	}
}
